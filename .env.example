# ОБРАЗЕЦ. Скопируйте в .env и заполните.
# .env закоммичен быть НЕ должен — он в .gitignore.
# На хостинге (Render) значения задаются в панели, а не файлом.

# Токен от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Ссылка на мини-приложение (GitHub Pages), например:
# https://USERNAME.github.io/kitob-bot/
WEBAPP_URL=https://malik-alaska2.github.io/Iqra-kitabak/

# ID администраторов через запятую (необязательно)
ADMIN_IDS=

# Путь к базе (по умолчанию data/kitob.sqlite3)
DB_PATH=

# Максимальный размер отправляемого файла в МБ (лимит Telegram — 50)
MAX_UPLOAD_MB=48
